# Copy this file to .env and fill in real values. NEVER commit .env.
# A loader (e.g. an IDE EnvFile plugin, direnv, or `export $(grep -v '^#' .env | xargs)`)
# must put these into the process environment before the app starts.

# JWT signing secret — use a long random string (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

SERVER_PORT=8080
SPRING_ACTIVE_PROFILES=dev

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=appdb
MYSQL_USERNAME=root
MYSQL_PASSWORD=
