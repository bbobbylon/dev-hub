# Copy to .env.local to point the app at a running backend (see ../server/) for local sign-in
# development. Leave unset (the default, including the deployed GitHub Pages build) and the app
# runs exactly as it always has — localStorage-only progress, no sign-in link doing anything but
# showing an "isn't available in this deployment" message.
VITE_API_BASE_URL=http://localhost:8080
